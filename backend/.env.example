# PFIP Backend Environment Variables
ENVIRONMENT=development
PFIP_SECRET_KEY=dev-secret-change-in-production
DATABASE_URL=sqlite:///./pfip.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Google Gemini API Key for AI categorization, chat assistant, and insight narratives
# If omitted, local deterministic engines are used automatically.
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3.6-flash
GEMINI_MODEL_LITE=gemma-4-26b-a4b-it

# Rate limits (requests per minute)
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=30
